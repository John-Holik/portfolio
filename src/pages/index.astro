---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { projects, TAGS } from '../data/projects';

const year = new Date().getFullYear();
// Only offer a filter chip for tags something actually carries.
const used = TAGS.filter((t) => projects.some((p) => p.tags.includes(t)));
---

<Base>
  <nav>
    <div class="nav-inner">
      <div class="brand"><img class="mark" src="/headshot.jpg" alt="John Holik" width="28" height="28" /> {site.name}</div>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
        <a class="btn btn-primary" href={site.resume}>Résumé ↓</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <div class="pill"><span class="dot"></span> {site.availability}</div>
      <h1>{site.name}<br /><span class="accent">{site.role}</span></h1>
      <p class="lede">
        I build <strong>machine learning systems</strong> and the evidence that they work:
        probabilistic modeling, uncertainty quantification, and evaluation against human ground
        truth. Recent Computer Software Engineering grad, based in Chicago.
      </p>
      <div class="meta-row">
        <span>📍 {site.location}</span>
        <span class="sep">/</span>
        <span>{site.education}</span>
        <span class="sep">/</span>
        <span>{site.researchLine}</span>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href="#work">View work</a>
        <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/headshot.jpg" alt="John Holik" width="512" height="512" />
      </div>
    </div>
  </header>

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>Work</h2>
        <span class="head-note">Click any project to expand</span>
      </div>

      <div class="filters" role="group" aria-label="Filter projects by tag">
        <button class="filter is-active" data-filter="all" aria-pressed="true">
          All <span class="count">{projects.length}</span>
        </button>
        {
          used.map((tag) => (
            <button class="filter" data-filter={tag} aria-pressed="false">
              {tag}{' '}
              <span class="count">{projects.filter((p) => p.tags.includes(tag)).length}</span>
            </button>
          ))
        }
      </div>

      <div class="projects" id="projects">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <h2>About</h2>
      </div>
      <div class="about-grid about">
        <div>
          <p>
            I'm a software engineer working in <strong>applied machine learning</strong>:
            probabilistic modeling, uncertainty quantification, and rigorous model evaluation,
            alongside LLM application development.
          </p>
          <p>
            The thread through all of it is <strong>knowing whether to trust the model</strong>.
            Plenty of new grads can get one to produce output. My work is about the evidence:
            agreement against human ground truth (<strong>0.847 Cohen's κ</strong> on an independent
            26-annotator consensus), calibrated probabilities instead of raw scores
            (<strong>0.0499 Brier</strong> on the credit-risk model), and full predictive
            distributions where a point estimate would be dishonest (four ensemble UQ methods in the
            red-tide package, scored on CRPS, coverage, and spread-skill).
          </p>
          <p>
            Two projects anchor that. <strong>ElectriAI</strong>, an independent research project I
            built end to end, advised at FGCU and funded by the Head Start Grant, is now a paper on
            which I am second author, submitted to the <strong>Journal of Management in
            Engineering</strong> (ASCE) and under review. <strong>Red Tide Reanalysis</strong> is my
            senior capstone, where I was sole developer of all code across five repositories,
            including an Ensemble Kalman Filter written from scratch in NumPy and an LSTM surrogate
            forward operator, published as a public Jupyter Book.
          </p>
          <p>
            I ship the models too, across React, FastAPI, PostgreSQL, and Cloudflare, with
            systems-level fundamentals in C++ and assembly behind that.
          </p>
        </div>
        <div class="facts">
          <div class="fact">
            <div class="k">EDUCATION</div>
            <div class="v">B.S. Computer Software Engineering, FGCU '26 · Dean's List</div>
          </div>
          <div class="fact">
            <div class="k">FOCUS</div>
            <div class="v">Applied ML · uncertainty quantification · model evaluation</div>
          </div>
          <div class="fact">
            <div class="k">ML STACK</div>
            <div class="v">Python · scikit-learn · TensorFlow/Keras · NumPy · SciPy · pandas</div>
          </div>
          <div class="fact">
            <div class="k">METHODS</div>
            <div class="v">EnKF · GLUE · bootstrap · LSTM · CRPS / coverage / calibration</div>
          </div>
          <div class="fact">
            <div class="k">LLM</div>
            <div class="v">OpenAI · Anthropic · Gemini · RAG and embeddings · agent development</div>
          </div>
          <div class="fact">
            <div class="k">SHIPPING</div>
            <div class="v">React · FastAPI · PostgreSQL · Cloudflare · pytest + Hypothesis</div>
          </div>
          <div class="fact">
            <div class="k">LOCATION</div>
            <div class="v">{site.location}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer id="contact">
    <div class="wrap">
      <div class="foot-cta">
        <h2>Let's build something.</h2>
        <p>
          Open to machine learning and AI engineering roles, and always up for a good problem. The
          fastest way to reach me is email.
        </p>
        <div class="foot-links">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn btn-ghost" href={site.resume}>Résumé ↓</a>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {year} {site.name}</span>
        <span>Built with Astro · deployed on Cloudflare</span>
      </div>
    </div>
  </footer>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLDetailsElement>('#projects .card');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      buttons.forEach((b) => {
        const active = b === button;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      // Filtering only hides and shows. Whatever the visitor expanded stays expanded.
      cards.forEach((card) => {
        const tags = (card.dataset.tags || '').split('|');
        card.hidden = filter !== 'all' && !tags.includes(filter || '');
      });
    });
  });
</script>
